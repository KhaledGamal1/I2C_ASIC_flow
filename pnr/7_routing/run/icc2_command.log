gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {149.165 35.815}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 0.5 -at_point {147.780 36.180}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 0.5 -at_point {147.795 36.200}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 0.5 -at_point {147.800 36.150}
gui_show_map -window [gui_get_current_window -types Layout -mru] -map {cellMapUtilMap} -show {false}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {11.940 135.780}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {11.940 135.780}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {13.575 135.555}
